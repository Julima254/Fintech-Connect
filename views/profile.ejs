<%- include('partials/header.ejs'); -%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>My Profile</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #0a1628;
            color: #ffffff;
            min-height: 100vh;
            padding: 20px;
        }

        .page-wrapper {
            max-width: 860px;
            margin: 0 auto;
            padding: 20px 0;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #00e676;
            margin-bottom: 6px;
        }

        .page-subtitle {
            color: #a0aec0;
            font-size: 0.9rem;
            margin-bottom: 30px;
        }

        /* Flash Messages */
        .flash {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }
        .flash.success {
            background-color: rgba(0, 230, 118, 0.15);
            border: 1px solid #00e676;
            color: #00e676;
        }
        .flash.error {
            background-color: rgba(255, 82, 82, 0.15);
            border: 1px solid #ff5252;
            color: #ff5252;
        }

        /* Info Cards Row */
        .info-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 30px;
        }

        .info-card {
            background: #0d2045;
            border: 1px solid #1a3a6b;
            border-radius: 10px;
            padding: 16px;
            text-align: center;
        }

        .info-card .label {
            font-size: 0.72rem;
            color: #a0aec0;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 6px;
        }

        .info-card .value {
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffd600;
        }

        .info-card .value.green { color: #00e676; }
        .info-card .value.white { color: #ffffff; }

        /* Section Cards */
        .card {
            background: #0d2045;
            border: 1px solid #1a3a6b;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid #1a3a6b;
        }

        .card-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(0, 230, 118, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .card-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: #ffffff;
        }

        .card-desc {
            font-size: 0.8rem;
            color: #a0aec0;
        }

        /* Form */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full { grid-column: 1 / -1; }

        label {
            font-size: 0.8rem;
            color: #a0aec0;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        input, select {
            background: #0a1628;
            border: 1px solid #1a3a6b;
            border-radius: 8px;
            padding: 11px 14px;
            color: #ffffff;
            font-size: 0.92rem;
            transition: border-color 0.2s;
            width: 100%;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #00e676;
        }

        input[readonly] {
            opacity: 0.5;
            cursor: not-allowed;
        }

        input::placeholder { color: #4a5568; }

        select option { background: #0a1628; }

        /* Password toggle */
        .input-wrap {
            position: relative;
        }

        .input-wrap input {
            padding-right: 44px;
        }

        .toggle-pw {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #a0aec0;
            cursor: pointer;
            font-size: 1rem;
            padding: 0;
            line-height: 1;
        }

        .toggle-pw:hover { color: #00e676; }

        /* Hint */
        .hint {
            font-size: 0.75rem;
            color: #4a5568;
            margin-top: 2px;
        }

        /* Buttons */
        .btn {
            padding: 11px 24px;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }

        .btn:hover { opacity: 0.88; transform: translateY(-1px); }
        .btn:active { transform: translateY(0); }

        .btn-primary {
            background: #00e676;
            color: #0a1628;
        }

        .btn-danger {
            background: transparent;
            color: #ff5252;
            border: 1px solid #ff5252;
        }

        .btn-danger:hover { background: rgba(255,82,82,0.1); opacity: 1; }

        .form-footer {
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        /* Account info strip */
        .account-strip {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }

        .strip-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .strip-item .s-label {
            font-size: 0.72rem;
            color: #a0aec0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .strip-item .s-value {
            font-size: 0.95rem;
            color: #ffffff;
            font-weight: 500;
        }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-package {
            background: rgba(255, 214, 0, 0.15);
            color: #ffd600;
            border: 1px solid #ffd600;
        }

        .badge-admin {
            background: rgba(0, 230, 118, 0.15);
            color: #00e676;
            border: 1px solid #00e676;
        }

        .badge-user {
            background: rgba(160, 174, 192, 0.15);
            color: #a0aec0;
            border: 1px solid #a0aec0;
        }

        /* Danger zone */
        .danger-zone {
            border-color: rgba(255, 82, 82, 0.3);
        }

        .danger-zone .card-icon {
            background: rgba(255, 82, 82, 0.12);
        }

        /* Responsive */
        @media (max-width: 600px) {
            .form-grid { grid-template-columns: 1fr; }
            .form-group.full { grid-column: 1; }
            .page-title { font-size: 1.4rem; }
            .card { padding: 18px; }
        }
    </style>
</head>
<body>

<div class="page-wrapper">

    <h1 class="page-title">👤 My Profile</h1>
    <p class="page-subtitle">Manage your account details and security settings</p>

    <!-- Flash Messages -->
    <% if (success && success.length > 0) { %>
        <div class="flash success">✅ <%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="flash error">⚠️ <%= error[0] %></div>
    <% } %>

    <!-- Balance Overview Cards -->
    <div class="info-cards">
        <div class="info-card">
            <div class="label">Wallet</div>
            <div class="value green">$<%= user.walletBalance.toFixed(2) %></div>
        </div>
        <div class="info-card">
            <div class="label">Deposit</div>
            <div class="value green">$<%= user.depositBalance.toFixed(2) %></div>
        </div>
        <div class="info-card">
            <div class="label">Referral Earnings</div>
            <div class="value">$<%= user.referralEarnings.toFixed(2) %></div>
        </div>
        <div class="info-card">
            <div class="label">Tasks Balance</div>
            <div class="value">$<%= user.tasksBalance.toFixed(2) %></div>
        </div>
        <div class="info-card">
            <div class="label">Shares</div>
            <div class="value white">$<%= user.sharesBalance.toFixed(2) %></div>
        </div>
    </div>

    <!-- Account Overview -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">📋</div>
            <div>
                <div class="card-title">Account Overview</div>
                <div class="card-desc">Your account status and membership info</div>
            </div>
        </div>
        <div class="account-strip">
            <div class="strip-item">
                <span class="s-label">Username</span>
                <span class="s-value">@<%= user.username %></span>
            </div>
            <div class="strip-item">
                <span class="s-label">Package</span>
                <span class="badge badge-package"><%= user.package %></span>
            </div>
            <div class="strip-item">
                <span class="s-label">Role</span>
                <% if (user.isAdmin) { %>
                    <span class="badge badge-admin">Admin</span>
                <% } else { %>
                    <span class="badge badge-user">Member</span>
                <% } %>
            </div>
            <div class="strip-item">
                <span class="s-label">Member Since</span>
                <span class="s-value"><%= user.createdAt.toDateString() %></span>
            </div>
            <% if (user.invitationCode) { %>
            <div class="strip-item">
                <span class="s-label">Invitation Code Used</span>
                <span class="s-value"><%= user.invitationCode %></span>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Update Details -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">✏️</div>
            <div>
                <div class="card-title">Personal Details</div>
                <div class="card-desc">Update your contact and location info</div>
            </div>
        </div>
        <form action="/profile/update-details" method="POST">
            <div class="form-grid">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" value="<%= user.username %>" readonly/>
                    <span class="hint">Username cannot be changed</span>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" name="email" id="email" value="<%= user.email %>" required/>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" name="phone" id="phone" value="<%= user.phone %>" required/>
                </div>
                <div class="form-group">
                    <label for="whatsappNumber">WhatsApp Number</label>
                    <input type="tel" name="whatsappNumber" id="whatsappNumber" value="<%= user.whatsappNumber %>" placeholder="+254700000000"/>
                </div>
                <div class="form-group full">
                    <label for="country">Country</label>
                    <input type="text" name="country" id="country" value="<%= user.country %>" required/>
                </div>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>

    <!-- Change Password -->
    <div class="card danger-zone">
        <div class="card-header">
            <div class="card-icon">🔒</div>
            <div>
                <div class="card-title">Change Password</div>
                <div class="card-desc">You'll be logged out after a successful change</div>
            </div>
        </div>
        <form action="/profile/change-password" method="POST">
            <div class="form-grid">
                <div class="form-group full">
                    <label for="currentPassword">Current Password</label>
                    <div class="input-wrap">
                        <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter current password" required/>
                        <button type="button" class="toggle-pw" onclick="togglePw('currentPassword', this)">👁</button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <div class="input-wrap">
                        <input type="password" name="newPassword" id="newPassword" placeholder="Min. 6 characters" required/>
                        <button type="button" class="toggle-pw" onclick="togglePw('newPassword', this)">👁</button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="input-wrap">
                        <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Repeat new password" required/>
                        <button type="button" class="toggle-pw" onclick="togglePw('confirmPassword', this)">👁</button>
                    </div>
                </div>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-danger">Update Password</button>
            </div>
        </form>
    </div>

</div>

<script>
    function togglePw(fieldId, btn) {
        const input = document.getElementById(fieldId);
        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '🙈';
        } else {
            input.type = 'password';
            btn.textContent = '👁';
        }
    }
</script>

</body>
</html>