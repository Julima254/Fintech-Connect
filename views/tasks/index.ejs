<%- include('../partials/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tasks Hub</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:  #0a1628;
      --blue:  #0d2b55;
      --green: #00e676;
      --yellow:#ffd600;
      --white: #ffffff;
      --muted: #a0b0c8;
    }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: var(--navy);
      color: var(--white);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    .badge {
      background: var(--green);
      color: var(--navy);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.3rem 0.9rem;
      border-radius: 2rem;
      margin-bottom: 1.4rem;
      display: inline-block;
    }
    h1 {
      font-size: clamp(2rem, 6vw, 3.2rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 0.8rem;
      text-align: center;
    }
    h1 span { color: var(--green); }
    .sub {
      color: var(--muted);
      font-size: 1.05rem;
      text-align: center;
      max-width: 480px;
      margin: 0 auto 3rem;
      line-height: 1.6;
    }
    .cards {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 820px;
    }
    .card {
      background: var(--blue);
      border: 2px solid transparent;
      border-radius: 1.2rem;
      padding: 2.2rem 2rem;
      flex: 1 1 320px;
      max-width: 380px;
      text-align: center;
      transition: border-color 0.2s, transform 0.2s;
      text-decoration: none;
      color: inherit;
    }
    .card:hover { border-color: var(--green); transform: translateY(-4px); }
    .card .icon { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .card h2 { font-size: 1.35rem; font-weight: 700; margin-bottom: 0.7rem; }
    .card p { color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.5rem; }
    .btn {
      display: inline-block;
      padding: 0.7rem 1.8rem;
      border-radius: 0.6rem;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.88; }
    .btn-green  { background: var(--green);  color: var(--navy); }
    .btn-yellow { background: var(--yellow); color: var(--navy); }
    .flash {
      padding: 0.8rem 1.2rem;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
      font-size: 0.93rem;
      width: 100%;
      max-width: 820px;
    }
    .flash-success { background: rgba(0,230,118,0.15); border: 1px solid var(--green); color: var(--green); }
    .flash-error   { background: rgba(255,82,82,0.15);  border: 1px solid #ff5252;     color: #ff5252; }
  </style>
</head>
<body>
  <% if (success && success.length > 0) { %>
    <div class="flash flash-success"><%= success[0] %></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="flash flash-error"><%= error[0] %></div>
  <% } %>

  <div class="badge">Tasks Hub</div>
  <h1>Work. Earn. <span>Grow.</span></h1>
  <p class="sub">Find tasks that pay or advertise your skills to clients looking for talent.</p>

  <div class="cards">
    <a href="/tasks/explore" class="card">
      <span class="icon">🔍</span>
      <h2>Explore Tasks</h2>
      <p>Browse available jobs posted by clients. Reserve a task, complete it within the deadline, and get paid once approved.</p>
      <span class="btn btn-green">Browse Tasks</span>
    </a>
    <a href="/tasks/post-service" class="card">
      <span class="icon">✨</span>
      <h2>Post What You Do</h2>
      <p>Advertise your skills and services to potential clients. Add your pricing, social contacts, and optionally a photo.</p>
      <span class="btn btn-yellow">Offer Services</span>
    </a>
  </div>
</body>
</html>