<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css"/>
    <style>
        :root {
            --navy:         #030D1A;
            --navy-mid:     #071428;
            --navy-card:    #0B1E38;
            --green:        #00E676;
            --green-glow:   rgba(0, 230, 118, 0.15);
            --green-border: rgba(0, 230, 118, 0.25);
            --yellow:       #FFD600;
            --yellow-glow:  rgba(255, 214, 0, 0.15);
            --white:        #FFFFFF;
            --white-dim:    #C8D8EE;
            --muted:        #5A7A9A;
            --danger:       #FF4D6D;
            --header-h:     62px;
            --font-display: 'Orbitron', monospace;
            --font-body:    'Space Grotesk', sans-serif;
            --transition:   0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-body);
            background: var(--navy);
            color: var(--white-dim);
            overflow-x: hidden;
        }

        .header {
            position: sticky;
            top: 0;
            z-index: 1000;
            height: var(--header-h);
            background: var(--navy-mid);
            border-bottom: 1px solid var(--green-border);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.6), 0 1px 0 var(--green-border);
        }

        .header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(0, 230, 118, 0.015) 2px,
                rgba(0, 230, 118, 0.015) 4px
            );
            pointer-events: none;
        }

        .header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--green), var(--yellow), var(--green), transparent);
            opacity: 0.6;
        }

        .nav-container {
            display: flex;
            align-items: center;
            height: 100%;
            padding: 0 1rem;
            gap: 0.75rem;
            position: relative;
        }

        .logo { flex-shrink: 0; }

        .logo a {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .logo img {
            height: 34px;
            width: auto;
            object-fit: contain;
            filter: drop-shadow(0 0 6px rgba(0, 230, 118, 0.4));
        }

        .admin-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-family: var(--font-display);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--navy);
            background: var(--yellow);
            padding: 5px 10px;
            border-radius: 4px;
            text-decoration: none;
            white-space: nowrap;
            box-shadow: 0 0 12px var(--yellow-glow);
            transition: var(--transition);
            flex-shrink: 0;
        }

        .admin-link::before { content: '⬡'; font-size: 10px; }

        .admin-link:hover {
            background: #FFE033;
            box-shadow: 0 0 20px rgba(255, 214, 0, 0.4);
            transform: translateY(-1px);
        }

        .userinfo {
            margin-left: auto;
            margin-right: 0.5rem;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 2px;
        }

        .username {
            font-family: var(--font-display);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--white);
            text-transform: uppercase;
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .status {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.05em;
        }

        .status.active  { color: var(--green); }
        .status.inactive { color: var(--danger); }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
            animation: pulse 2s infinite;
        }

        .status.active .status-dot {
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
        }

        .status.inactive .status-dot {
            background: var(--danger);
            box-shadow: 0 0 8px var(--danger);
            animation: none;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.5; transform: scale(0.8); }
        }

        .menu-toggle {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
            width: 40px;
            height: 40px;
            background: var(--navy-card);
            border: 1px solid var(--green-border);
            border-radius: 6px;
            cursor: pointer;
            flex-shrink: 0;
            transition: var(--transition);
            padding: 8px;
        }

        .menu-toggle span {
            display: block;
            width: 100%;
            height: 2px;
            background: var(--green);
            border-radius: 2px;
            transition: var(--transition);
            transform-origin: center;
        }

        .menu-toggle:hover {
            background: var(--green-glow);
            border-color: var(--green);
            box-shadow: 0 0 12px var(--green-glow);
        }

        .menu-toggle.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .menu-toggle.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
        .menu-toggle.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .nav-overlay {
            display: none;
            position: fixed;
            inset: 0;
            top: var(--header-h);
            background: rgba(3, 13, 26, 0.75);
            backdrop-filter: blur(4px);
            z-index: 998;
        }

        .nav-overlay.show { display: block; }

        .nav {
            position: fixed;
            top: var(--header-h);
            right: 0;
            width: min(300px, 80vw);
            height: calc(100dvh - var(--header-h));
            background: var(--navy-mid);
            border-left: 1px solid var(--green-border);
            overflow-y: auto;
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 999;
            padding: 1rem 0 2rem;
        }

        .nav::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(0,230,118,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,230,118,0.03) 1px, transparent 1px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        .nav.open { transform: translateX(0); }

        .nav ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .nav ul::before {
            content: 'NAVIGATION';
            display: block;
            font-family: var(--font-display);
            font-size: 8px;
            letter-spacing: 0.2em;
            color: var(--muted);
            padding: 0.5rem 1.5rem 0.75rem;
        }

        .nav ul li a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.8rem 1.5rem;
            font-size: 13px;
            font-weight: 500;
            color: var(--white-dim);
            text-decoration: none;
            border-left: 2px solid transparent;
            transition: var(--transition);
        }

        .nav ul li a::before {
            content: '›';
            font-size: 16px;
            color: var(--muted);
            transition: var(--transition);
        }

        .nav ul li a:hover {
            color: var(--green);
            background: var(--green-glow);
            border-left-color: var(--green);
            padding-left: 1.75rem;
        }

        .nav ul li a:hover::before { color: var(--green); }

        #copyReferralLink { color: var(--yellow) !important; }
        #copyReferralLink::before { color: var(--yellow) !important; }
        #copyReferralLink:hover {
            background: var(--yellow-glow) !important;
            border-left-color: var(--yellow) !important;
        }

        .logout-btn {
            color: var(--danger) !important;
            margin-top: 0.5rem;
            border-top: 1px solid rgba(255, 77, 109, 0.15);
        }

        .logout-btn::before { color: var(--danger) !important; }

        .logout-btn:hover {
            background: rgba(255, 77, 109, 0.1) !important;
            border-left-color: var(--danger) !important;
        }

        /* ── TABLET ── */
        @media (min-width: 600px) {
            :root { --header-h: 66px; }
            .nav-container { padding: 0 1.5rem; }
            .logo img { height: 38px; }
            .username { max-width: 130px; font-size: 11px; }
        }

        /* ── DESKTOP ── */
@media (min-width: 1024px) {
    :root { --header-h: 70px; }

    .nav-container { padding: 0 2.5rem; gap: 1.5rem; }
    .logo img { height: 40px; }
    .username { max-width: 160px; font-size: 11px; }

    /* Drawer gets a bit wider on desktop */
    .nav {
        width: 320px;
    }
}
    </style>
</head>
<body>

<header class="header">
  <div class="nav-container">

    <div class="logo">
      <a href="/home">
        <img src="/images/logono.png" alt="Fintech Connect logo" />
      </a>
    </div>

    <% if (currentUser && currentUser.isAdmin) { %>
      <a href="/admin" class="admin-link">Admin</a>
    <% } %>

    <div class="userinfo">
      <% if (currentUser) { %>
        <span class="username"><%= currentUser.username %></span>
      <% } %>
      <p class="status <%= user && user.package && user.package !== 'None' ? 'active' : 'inactive' %>">
        <span class="status-dot"></span>
        <%= user && user.package && user.package !== 'None' ? 'Active' : 'Inactive' %>
      </p>
    </div>

    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav" id="mainNav" aria-label="Main navigation">
      <ul>
        <li><a href="/home">Home</a></li>
        <li><a href="/account-packages">Account Packages</a></li>
        <li><a href="#" id="copyReferralLink">Copy Referral Link</a></li>
        <li><a href="/Tasks">Explore Tasks</a></li>
        <li><a href="/Hire-Freelancers">Hire Freelancers</a></li>
        <li><a href="/Shares">Buy Shares</a></li>
        <li><a href="/transactions">Transactions</a></li>
        <li><a href="/team">My Team</a></li>
        <li><a href="/profile">Profile</a></li>
        <li>
          <a href="https://wa.me/254741058364" target="_blank" rel="noopener noreferrer">
            Customer Care
          </a>
        </li>
        <li><a href="/logout" class="logout-btn">Logout</a></li>
      </ul>
    </nav>

  </div>
</header>

<div class="nav-overlay" id="navOverlay"></div>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mainNav    = document.getElementById('mainNav');
  const overlay    = document.getElementById('navOverlay');

  function openMenu() {
    mainNav.classList.add('open');
    overlay.classList.add('show');
    menuToggle.classList.add('active');
    menuToggle.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    mainNav.classList.remove('open');
    overlay.classList.remove('show');
    menuToggle.classList.remove('active');
    menuToggle.setAttribute('aria-expanded', 'false');
  }

  menuToggle.addEventListener('click', () => {
    mainNav.classList.contains('open') ? closeMenu() : openMenu();
  });

  overlay.addEventListener('click', closeMenu);

  mainNav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) closeMenu();
    });
  });
</script>

<script>
  const copyBtn = document.getElementById('copyReferralLink');

  copyBtn.addEventListener('click', (e) => {
    e.preventDefault();
    const referralLink = `<%= currentUser ? "https://fintech-connect.onrender.com/register?ref=" + currentUser.username : "" %>`;

    if (!referralLink) {
      alert("No referral link available.");
      return;
    }

    navigator.clipboard.writeText(referralLink).then(() => {
      const original = copyBtn.textContent;
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => copyBtn.textContent = original, 2000);
    }).catch(() => {
      alert("Failed to copy referral link.");
    });
  });
</script>

</body>
</html>