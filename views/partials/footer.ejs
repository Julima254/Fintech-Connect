<!-- Footer Navigation -->
<style>
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #0a1e3f; /* dark blue */
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 8px 0;
    box-shadow: 0 -2px 8px rgba(0,0,0,0.2);
    z-index: 1000;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #cfd8e3; /* muted default color */
    text-decoration: none;
    font-size: 11px;
    flex: 1;
    padding: 4px 0;
    transition: color 0.2s ease;
    cursor: pointer;
    background: none;
    border: none;
  }

  .nav-item svg {
    width: 22px;
    height: 22px;
    margin-bottom: 2px;
    stroke: #cfd8e3;
    fill: none;
    stroke-width: 2;
    transition: stroke 0.2s ease;
  }

  .nav-item:hover,
  .nav-item.active {
    color: #39ff14; /* bright green */
  }

  .nav-item:hover svg,
  .nav-item.active svg {
    stroke: #39ff14; /* bright green */
  }

  /* Prevent content from being hidden behind the fixed footer */
  body {
    padding-bottom: 60px;
  }
</style>

<nav class="bottom-nav">
  <a href="/shares/dashboard" class="nav-item active" id="nav-home">
    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
    Home
  </a>

  <a href="/savings" class="nav-item" id="nav-savings">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M8 10h4a2 2 0 010 4H9"/></svg>
    Savings
  </a>

  <a href="/loans" class="nav-item" id="nav-loans">
    <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18"/><path d="M7 15h.01"/></svg>
    Loans
  </a>

  <a href="/shares" class="nav-item" id="nav-shares">
    <svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
    Shares
  </a>

  <a href="/referrals" class="nav-item" id="nav-referrals">
    <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="17" r="3"/><path d="M10.5 9.5l4 6"/></svg>
    Referrals
  </a>

  <a href="/profile" class="nav-item" id="nav-profile">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
    Profile
  </a>
</nav>

<script>
  // Highlight active tab based on click
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', function(e) {
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      this.classList.add('active');
      // Navigation happens naturally via href, or replace with your router logic
    });
  });
</script>