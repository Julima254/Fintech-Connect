<%- include('../partials/header') %>

<div class="fl-page">
  <div class="fl-header-row">
    <a href="/hire-freelancers" class="fl-back">← Back</a>
    <h1 class="fl-page-title">My Posted Tasks</h1>
  </div>

  <% if (success && success.length > 0) { %>
    <div class="fl-alert fl-alert--success"><%= success[0] %></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="fl-alert fl-alert--error"><%= error[0] %></div>
  <% } %>

  <% if (!tasks || tasks.length === 0) { %>
    <div class="fl-empty">
      <p>You haven't posted any tasks yet.</p>
      <a href="/hire-freelancers/post-task" class="fl-btn fl-btn--primary">Post Your First Task</a>
    </div>
  <% } else { %>
    <div class="fl-task-list">
      <% tasks.forEach(function(task) { %>
        <div class="fl-task-card">
          <div class="fl-task-card__header">
            <div>
              <h2 class="fl-task-name"><%= task.taskName %></h2>
              <span class="fl-badge fl-badge--<%= task.status %>"><%= task.status.toUpperCase() %></span>
            </div>
            <div class="fl-task-meta">
              <span>⏱ <%= task.timeLimit %></span>
              <span>👥 <%= task.numWorkers %> workers</span>
              <span>💵 $<%= task.payPerTask.toFixed(2) %>/task</span>
              <span class="fl-escrow">🔒 Escrow: $<%= task.escrowAmount.toFixed(2) %></span>
            </div>
          </div>

          <div class="fl-task-card__body">
            <p><strong>Requirements:</strong> <%= task.minRequirements %></p>
            <p><strong>Expected:</strong> <%= task.expectedDeliverables %></p>
            <p><strong>Proof Required:</strong> <%= task.requiresProofImage ? '📷 Image' : '✍️ Text only' %></p>
          </div>

          <!-- Submissions -->
          <div class="fl-submissions">
            <h3 class="fl-submissions__title">
              Submissions
              <span class="fl-count"><%= task.submissions.length %></span>
            </h3>

            <% if (task.submissions.length === 0) { %>
              <p class="fl-no-sub">No submissions yet.</p>
            <% } else { %>
              <% task.submissions.forEach(function(sub) { %>
                <div class="fl-sub fl-sub--<%= sub.status %>">
                  <div class="fl-sub__info">
                    <span class="fl-sub__user">👤 <%= sub.submittedBy ? sub.submittedBy.username : 'Unknown' %></span>
                    <span class="fl-sub__date"><%= new Date(sub.submittedAt).toLocaleDateString() %></span>
                    <span class="fl-sub__status fl-badge fl-badge--<%= sub.status %>"><%= sub.status.toUpperCase() %></span>
                  </div>

                  <% if (sub.proofText) { %>
                    <p class="fl-sub__proof-text"><strong>Proof:</strong> <%= sub.proofText %></p>
                  <% } %>

                  <% if (sub.proofImage) { %>
                    <div class="fl-sub__proof-img">
                      <a href="/uploads/proofs/<%= sub.proofImage %>" target="_blank">
                        <img src="/uploads/proofs/<%= sub.proofImage %>" alt="Proof Image" />
                      </a>
                    </div>
                  <% } %>

                  <% if (sub.status === 'pending') { %>
                    <div class="fl-sub__actions">
                      <form action="/hire-freelancers/approve/<%= task._id %>/<%= sub._id %>" method="POST" style="display:inline;">
                        <button type="submit" class="fl-btn fl-btn--approve">✅ Approve & Pay</button>
                      </form>
                      <form action="/hire-freelancers/reject/<%= task._id %>/<%= sub._id %>" method="POST" style="display:inline;">
                        <button type="submit" class="fl-btn fl-btn--reject">❌ Reject</button>
                      </form>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
