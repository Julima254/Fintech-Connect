<%- include('../partials/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Browse Freelancers</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #0a0f2c;
      color: #ffffff;
      min-height: 100vh;
    }

    /* ── HEADER ── */
    .browse-header {
      background: linear-gradient(135deg, #0a0f2c 0%, #0d1a4a 100%);
      border-bottom: 2px solid #00e676;
      padding: 24px 20px;
      text-align: center;
    }

    .browse-header h1 {
      font-size: clamp(1.4rem, 4vw, 2rem);
      color: #ffffff;
      letter-spacing: 1px;
    }

    .browse-header h1 span {
      color: #00e676;
    }

    .browse-header p {
      color: #aab4d4;
      margin-top: 6px;
      font-size: 0.9rem;
    }

    /* ── SEARCH & FILTER BAR ── */
    .filter-bar {
      background: #0d1a4a;
      padding: 16px 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid #1a2a6c;
    }

    .filter-bar form {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      width: 100%;
      max-width: 900px;
      align-items: center;
      justify-content: center;
    }

    .filter-bar input[type="text"] {
      flex: 1 1 220px;
      padding: 10px 14px;
      border-radius: 6px;
      border: 1px solid #1a2a6c;
      background: #0a0f2c;
      color: #ffffff;
      font-size: 0.9rem;
      outline: none;
      transition: border 0.2s;
    }

    .filter-bar input[type="text"]:focus {
      border-color: #00e676;
    }

    .filter-bar select {
      flex: 0 1 180px;
      padding: 10px 14px;
      border-radius: 6px;
      border: 1px solid #1a2a6c;
      background: #0a0f2c;
      color: #ffffff;
      font-size: 0.9rem;
      outline: none;
      cursor: pointer;
    }

    .filter-bar select:focus {
      border-color: #00e676;
    }

    .btn-search {
      padding: 10px 22px;
      background: #00e676;
      color: #0a0f2c;
      border: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-search:hover {
      background: #00c853;
    }

    /* ── RESULTS COUNT ── */
    .results-info {
      max-width: 1100px;
      margin: 18px auto 0;
      padding: 0 20px;
      font-size: 0.85rem;
      color: #aab4d4;
    }

    .results-info span {
      color: #ffd600;
      font-weight: 700;
    }

    /* ── GRID ── */
    .services-grid {
      max-width: 1100px;
      margin: 18px auto 40px;
      padding: 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }

    /* ── CARD ── */
    .service-card {
      background: #0d1a4a;
      border: 1px solid #1a2a6c;
      border-radius: 10px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: transform 0.2s, border-color 0.2s;
    }

    .service-card:hover {
      transform: translateY(-3px);
      border-color: #00e676;
    }

    .card-category {
      display: inline-block;
      background: #ffd600;
      color: #0a0f2c;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 3px 10px;
      border-radius: 20px;
      align-self: flex-start;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
    }

    .card-description {
      font-size: 0.85rem;
      color: #aab4d4;
      line-height: 1.5;
      flex: 1;
      /* clamp to 3 lines */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-price {
      font-size: 1.1rem;
      font-weight: 800;
      color: #00e676;
    }

    .card-price span {
      font-size: 0.75rem;
      color: #aab4d4;
      font-weight: 400;
    }

    /* poster row */
    .card-poster {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid #1a2a6c;
    }

    .poster-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #1a2a6c;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 700;
      color: #ffd600;
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .poster-name {
      font-size: 0.82rem;
      color: #aab4d4;
    }

    .poster-name strong {
      color: #ffffff;
      display: block;
    }

    /* WhatsApp button */
    .btn-whatsapp {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px;
      background: #25D366;
      color: #ffffff;
      border: none;
      border-radius: 7px;
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: auto;
    }

    .btn-whatsapp:hover {
      background: #1ebe5d;
    }

    .btn-whatsapp svg {
      width: 18px;
      height: 18px;
      fill: #ffffff;
      flex-shrink: 0;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      grid-column: 1 / -1;
    }

    .empty-state .icon {
      font-size: 3rem;
      margin-bottom: 14px;
    }

    .empty-state h3 {
      color: #ffd600;
      font-size: 1.2rem;
      margin-bottom: 8px;
    }

    .empty-state p {
      color: #aab4d4;
      font-size: 0.9rem;
    }

    /* ── FLASH MESSAGES ── */
    .flash {
      max-width: 1100px;
      margin: 14px auto 0;
      padding: 0 20px;
    }

    .flash-error {
      background: #3a0a0a;
      border-left: 4px solid #ff5252;
      color: #ff8a80;
      padding: 12px 16px;
      border-radius: 6px;
      font-size: 0.88rem;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 500px) {
      .services-grid {
        grid-template-columns: 1fr;
      }

      .filter-bar input[type="text"],
      .filter-bar select {
        flex: 1 1 100%;
      }

      .btn-search {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="browse-header">
    <h1>Browse <span>Freelancers</span></h1>
    <p>Find skilled people and connect directly via WhatsApp</p>
  </div>

  <!-- FLASH -->
  <% if (error && error.length) { %>
    <div class="flash">
      <div class="flash-error"><%= error[0] %></div>
    </div>
  <% } %>

  <!-- SEARCH & FILTER -->
  <div class="filter-bar">
    <form method="GET" action="/hire-freelancers/browse">
      <input
        type="text"
        name="search"
        placeholder="Search services..."
        value="<%= searchQuery %>"
      />
      <select name="category">
        <option value="all" <%= currentCategory === 'all' ? 'selected' : '' %>>All Categories</option>
        <% allCategories.forEach(cat => { %>
          <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>>
            <%= cat %>
          </option>
        <% }) %>
      </select>
      <button type="submit" class="btn-search">Search</button>
    </form>
  </div>

  <!-- RESULTS COUNT -->
  <div class="results-info">
    Showing <span><%= services.length %></span>
    <%= services.length === 1 ? 'service' : 'services' %>
    <% if (searchQuery) { %> for "<%= searchQuery %>"<% } %>
    <% if (currentCategory !== 'all') { %> in <strong><%= currentCategory %></strong><% } %>
  </div>

  <!-- GRID -->
  <div class="services-grid">

    <% if (services.length === 0) { %>
      <div class="empty-state">
        <div class="icon">🔍</div>
        <h3>No services found</h3>
        <p>Try a different search term or category.</p>
      </div>
    <% } else { %>

      <% services.forEach(service => { %>
        <div class="service-card">

          <% if (service.category) { %>
            <span class="card-category"><%= service.category %></span>
          <% } %>

          <div class="card-title"><%= service.title %></div>
          <div class="card-description"><%= service.description %></div>

          <% if (service.price) { %>
            <div class="card-price">
              KES <%= service.price.toLocaleString() %>
              <span>/ task</span>
            </div>
          <% } %>

          <!-- Poster info -->
          <div class="card-poster">
            <div class="poster-avatar">
              <%= service.postedBy?.username?.charAt(0) || '?' %>
            </div>
            <div class="poster-name">
              <strong><%= service.postedBy?.username || 'Unknown' %></strong>
              Posted by
            </div>
          </div>

          <!-- WhatsApp button -->
          <% if (service.socialMedia && service.socialMedia.whatsapp) { %>
  <a class="btn-whatsapp" href="https://wa.me/<%= service.socialMedia.whatsapp.replace(/\D/g,'') %>?text=Hi%20<%= encodeURIComponent(service.postedBy.username) %>%2C%20I%20saw%20your%20service%20and%20I%27m%20interested!" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
    Contact on WhatsApp
  </a>
<% } else { %>
  <div class="no-whatsapp">No WhatsApp number listed</div>
<% } %>

        </div>
      <% }) %>

    <% } %>
  </div>

</body>
</html>