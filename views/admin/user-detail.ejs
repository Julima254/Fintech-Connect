<%- include('../partials/adminHeader.ejs'); -%>

<div class="admin-layout">

  <main class="admin-main">

    <!-- BACK LINK -->
    <a href="/admin/users" class="back-link">← Back to Users</a>

    <!-- FLASH -->
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- USER HEADER CARD -->
    <div class="user-header-card">
      <div class="user-avatar-lg"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="user-header-info">
        <h2>
          <%= user.username %>
          <% if (user.isAdmin) { %><span class="badge badge-admin">Admin</span><% } %>
        </h2>
        <p><%= user.email %> &nbsp;|&nbsp; <%= user.phone %> &nbsp;|&nbsp; <%= user.country %></p>
        <p class="muted">Joined: <%= new Date(user.createdAt).toLocaleString('en-KE') %></p>
        <% if (user.referrer) { %>
          <p class="muted">Referred by: <strong><%= user.referrer.username %></strong> (<%= user.referrer.email %>)</p>
        <% } %>
      </div>
      <div class="user-header-actions">
        <!-- Toggle Admin -->
        <form method="POST" action="/admin/users/<%= user._id %>/toggle-admin"
              onsubmit="return confirm('Toggle admin status for <%= user.username %>?')">
          <button class="btn <%= user.isAdmin ? 'btn-danger' : 'btn-warning' %>">
            <%= user.isAdmin ? 'Remove Admin' : 'Make Admin' %>
          </button>
        </form>
        <!-- Delete User -->
        <form method="POST" action="/admin/users/<%= user._id %>/delete"
              onsubmit="return confirm('PERMANENTLY delete <%= user.username %> and all their transactions? This cannot be undone.')">
          <button class="btn btn-danger">Delete User</button>
        </form>
      </div>
    </div>

    <!-- BALANCE CARDS -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon green">💳</div>
        <div class="stat-info">
          <span class="stat-value">KES <%= user.walletBalance.toLocaleString() %></span>
          <span class="stat-label">Wallet Balance</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue">🏦</div>
        <div class="stat-info">
          <span class="stat-value">KES <%= user.depositBalance.toLocaleString() %></span>
          <span class="stat-label">Deposit Balance</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon yellow">🤝</div>
        <div class="stat-info">
          <span class="stat-value">KES <%= user.referralEarnings.toLocaleString() %></span>
          <span class="stat-label">Referral Earnings</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green">📋</div>
        <div class="stat-info">
          <span class="stat-value">KES <%= user.tasksBalance.toLocaleString() %></span>
          <span class="stat-label">Tasks Balance</span>
        </div>
      </div>
    </div>

    <!-- TWO-COL GRID -->
    <div class="detail-grid">

      <!-- LEFT: EDIT PROFILE -->
      <div class="detail-section">
        <h3 class="section-title">Edit Profile</h3>
        <form method="POST" action="/admin/users/<%= user._id %>/edit" class="edit-form">

          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" value="<%= user.email %>" class="form-input" />
          </div>

          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="phone" value="<%= user.phone %>" class="form-input" />
          </div>

          <div class="form-group">
            <label>Package</label>
            <select name="package" class="form-input">
              <% ["None","Starter","Bronze","Silver","Gold"].forEach(p => { %>
                <option value="<%= p %>" <%= user.package === p ? 'selected' : '' %>><%= p %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label>Wallet Balance (KES)</label>
            <input type="number" name="walletBalance" value="<%= user.walletBalance %>" class="form-input" step="0.01" />
          </div>

          <div class="form-group">
            <label>Deposit Balance (KES)</label>
            <input type="number" name="depositBalance" value="<%= user.depositBalance %>" class="form-input" step="0.01" />
          </div>

          <div class="form-group">
            <label>Referral Earnings (KES)</label>
            <input type="number" name="referralEarnings" value="<%= user.referralEarnings %>" class="form-input" step="0.01" />
          </div>

          <div class="form-group">
            <label>Tasks Balance (KES)</label>
            <input type="number" name="tasksBalance" value="<%= user.tasksBalance %>" class="form-input" step="0.01" />
          </div>

          <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
        </form>
      </div>

      <!-- RIGHT: ADJUST BALANCE -->
      <div class="detail-section">
        <h3 class="section-title">Credit / Debit Balance</h3>
        <form method="POST" action="/admin/users/<%= user._id %>/adjust-balance" class="edit-form">

          <div class="form-group">
            <label>Balance Type</label>
            <select name="balanceType" class="form-input">
              <option value="walletBalance">Wallet Balance</option>
              <option value="depositBalance">Deposit Balance</option>
              <option value="referralEarnings">Referral Earnings</option>
              <option value="tasksBalance">Tasks Balance</option>
            </select>
          </div>

          <div class="form-group">
            <label>Action</label>
            <select name="action" class="form-input">
              <option value="credit">Credit (Add)</option>
              <option value="debit">Debit (Deduct)</option>
            </select>
          </div>

          <div class="form-group">
            <label>Amount (KES)</label>
            <input type="number" name="amount" placeholder="e.g. 500" class="form-input" min="1" step="0.01" required />
          </div>

          <div class="form-group">
            <label>Note (optional)</label>
            <input type="text" name="note" placeholder="Reason for adjustment" class="form-input" />
          </div>

          <button type="submit" class="btn btn-success btn-full">Apply Adjustment</button>
        </form>

        <!-- REFERRALS -->
        <h3 class="section-title" style="margin-top:2rem;">Referrals (<%= referrals.length %>)</h3>
        <% if (referrals.length === 0) { %>
          <p class="muted">No referrals yet.</p>
        <% } else { %>
          <div class="mini-table-wrap">
            <table class="data-table">
              <thead><tr><th>Username</th><th>Package</th><th>Joined</th></tr></thead>
              <tbody>
                <% referrals.forEach(r => { %>
                  <tr>
                    <td><a href="/admin/users/<%= r._id %>" class="link-blue"><%= r.username %></a></td>
                    <td><span class="badge badge-<%= r.package === 'None' ? 'none' : 'pkg' %>"><%= r.package %></span></td>
                    <td class="muted"><%= new Date(r.createdAt).toLocaleDateString('en-KE') %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>

    <!-- RECENT TRANSACTIONS -->
    <div class="detail-section full-width">
      <h3 class="section-title">Recent Transactions</h3>
      <% if (transactions.length === 0) { %>
        <p class="muted">No transactions found.</p>
      <% } else { %>
        <div class="table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(t => { %>
                <tr>
                  <td class="muted"><%= new Date(t.createdAt).toLocaleString('en-KE') %></td>
                  <td><span class="badge badge-<%= t.type %>"><%= t.type %></span></td>
                  <td class="<%= t.type === 'deposit' ? 'text-green' : 'text-yellow' %>">
                    KES <%= t.amount.toLocaleString() %>
                  </td>
                  <td class="muted"><%= t.method || '—' %></td>
                  <td><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
                  <td class="muted"><%= t.description || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </main>
</div>