<%- include('../partials/adminHeader.ejs'); -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin — Tasks</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #0a1628;
      --navy2:  #112040;
      --green:  #00e676;
      --green2: #00c853;
      --yellow: #ffd600;
      --white:  #ffffff;
      --muted:  #8a9bbf;
      --border: rgba(255,255,255,0.08);
      --card:   #0f1e38;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--navy);
      color: var(--white);
      /* push content right to account for sidebar — adjust width to match your sidebar */
      padding-left: 240px;
      min-height: 100vh;
    }

    /* ── TOP BAR ── */
    .topbar {
      background: var(--navy2);
      border-bottom: 1px solid var(--border);
      padding: 18px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .topbar h1 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--white);
    }
    .topbar h1 span { color: var(--green); }

    /* ── FLASH ── */
    .flash {
      margin: 20px 32px 0;
      padding: 12px 18px;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .flash.success { background: rgba(0,230,118,0.12); border-left: 3px solid var(--green); color: var(--green); }
    .flash.error   { background: rgba(255,80,80,0.12);  border-left: 3px solid #ff5050;    color: #ff5050; }

    /* ── MAIN CONTENT ── */
    .content { padding: 28px 32px; }

    /* ── STAT CARDS ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }
    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .stat-card.green::before  { background: var(--green); }
    .stat-card.yellow::before { background: var(--yellow); }
    .stat-card.blue::before   { background: #4fc3f7; }
    .stat-card.red::before    { background: #ff5050; }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .stat-value {
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1;
    }
    .stat-card.green  .stat-value { color: var(--green); }
    .stat-card.yellow .stat-value { color: var(--yellow); }
    .stat-card.blue   .stat-value { color: #4fc3f7; }
    .stat-card.red    .stat-value { color: #ff5050; }

    /* ── FILTER / SEARCH BAR ── */
    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .filter-tabs {
      display: flex;
      gap: 6px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 4px;
    }
    .filter-tab {
      padding: 7px 16px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      color: var(--muted);
      transition: all 0.15s;
    }
    .filter-tab.active, .filter-tab:hover {
      background: var(--green);
      color: var(--navy);
    }
    .search-form {
      display: flex;
      gap: 8px;
      margin-left: auto;
    }
    .search-form input {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 14px;
      color: var(--white);
      font-size: 0.85rem;
      width: 220px;
      outline: none;
      transition: border-color 0.15s;
    }
    .search-form input:focus { border-color: var(--green); }
    .search-form input::placeholder { color: var(--muted); }
    .btn {
      padding: 8px 18px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.15s;
    }
    .btn:hover { opacity: 0.85; }
    .btn-green  { background: var(--green);  color: var(--navy); }
    .btn-yellow { background: var(--yellow); color: var(--navy); }

    /* ── TABLE ── */
    .table-wrap {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.845rem;
    }
    thead {
      background: var(--navy2);
    }
    thead th {
      padding: 13px 16px;
      text-align: left;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
      font-weight: 600;
      white-space: nowrap;
    }
    tbody tr {
      border-top: 1px solid var(--border);
      transition: background 0.12s;
    }
    tbody tr:hover { background: rgba(255,255,255,0.03); }
    tbody td {
      padding: 13px 16px;
      vertical-align: middle;
    }

    .task-name {
      font-weight: 600;
      color: var(--white);
      margin-bottom: 2px;
    }
    .task-meta {
      font-size: 0.75rem;
      color: var(--muted);
    }

    /* badges */
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .badge-open    { background: rgba(0,230,118,0.15); color: var(--green); }
    .badge-closed  { background: rgba(255,80,80,0.15);  color: #ff5050; }
    .badge-pending { background: rgba(255,214,0,0.15);  color: var(--yellow); }

    .progress-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .progress-bar-bg {
      flex: 1;
      height: 6px;
      background: rgba(255,255,255,0.08);
      border-radius: 3px;
      min-width: 60px;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 3px;
      background: var(--green);
      transition: width 0.3s;
    }
    .progress-label {
      font-size: 0.72rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .kes {
      font-weight: 600;
      color: var(--yellow);
    }

    .action-link {
      color: var(--green);
      font-weight: 600;
      text-decoration: none;
      font-size: 0.82rem;
      border: 1px solid rgba(0,230,118,0.3);
      padding: 5px 12px;
      border-radius: 6px;
      transition: background 0.15s;
    }
    .action-link:hover {
      background: rgba(0,230,118,0.1);
    }

    .empty-state {
      text-align: center;
      padding: 56px 32px;
      color: var(--muted);
    }
    .empty-state svg { opacity: 0.3; margin-bottom: 16px; }
    .empty-state p { font-size: 0.9rem; }

    @media (max-width: 768px) {
      body { padding-left: 0; }
      .content { padding: 16px; }
      .topbar { padding: 14px 16px; }
      thead th:nth-child(n+4) { display: none; }
      tbody td:nth-child(n+4) { display: none; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="topbar">
    <h1>Task <span>Management</span></h1>
    <span style="font-size:0.8rem;color:var(--muted);">
      <%= stats.totalTasks %> task<%= stats.totalTasks !== 1 ? 's' : '' %> total
    </span>
  </div>

  <!-- FLASH MESSAGES -->
  <% if (typeof messages !== 'undefined') { %>
    <% if (messages.success && messages.success.length) { %>
      <div class="flash success"><%= messages.success[0] %></div>
    <% } %>
    <% if (messages.error && messages.error.length) { %>
      <div class="flash error"><%= messages.error[0] %></div>
    <% } %>
  <% } %>

  <div class="content">

    <!-- STAT CARDS -->
    <div class="stats-grid">
      <div class="stat-card blue">
        <div class="stat-label">Total Tasks</div>
        <div class="stat-value"><%= stats.totalTasks %></div>
      </div>
      <div class="stat-card green">
        <div class="stat-label">Open Tasks</div>
        <div class="stat-value"><%= stats.openTasks %></div>
      </div>
      <div class="stat-card red">
        <div class="stat-label">Closed Tasks</div>
        <div class="stat-value"><%= stats.closedTasks %></div>
      </div>
      <div class="stat-card yellow">
        <div class="stat-label">Pending Reviews</div>
        <div class="stat-value"><%= stats.pendingSubmissions %></div>
      </div>
      <div class="stat-card green">
        <div class="stat-label">Approved Subs</div>
        <div class="stat-value"><%= stats.approvedSubmissions %></div>
      </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
      <div class="filter-tabs">
        <a href="/admin/tasks?filter=all<%= search ? '&search='+search : '' %>"
           class="filter-tab <%= filter === 'all'    ? 'active' : '' %>">All</a>
        <a href="/admin/tasks?filter=open<%= search ? '&search='+search : '' %>"
           class="filter-tab <%= filter === 'open'   ? 'active' : '' %>">Open</a>
        <a href="/admin/tasks?filter=closed<%= search ? '&search='+search : '' %>"
           class="filter-tab <%= filter === 'closed' ? 'active' : '' %>">Closed</a>
      </div>

      <form class="search-form" method="GET" action="/admin/tasks">
        <input type="hidden" name="filter" value="<%= filter %>"/>
        <input type="text" name="search" placeholder="Search task name…"
               value="<%= search %>"/>
        <button class="btn btn-green" type="submit">Search</button>
        <% if (search) { %>
          <a href="/admin/tasks?filter=<%= filter %>" class="btn btn-yellow">Clear</a>
        <% } %>
      </form>
    </div>

    <!-- TABLE -->
    <div class="table-wrap">
      <% if (tasks.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2
                     M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <p>No tasks found for the selected filter.</p>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Task</th>
              <th>Status</th>
              <th>Progress</th>
              <th>Pay / Worker</th>
              <th>Escrow</th>
              <th>Pending</th>
              <th>Time Limit</th>
              <th>Posted</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(task => {
                 const pendingCount  = task.submissions.filter(s => s.status === 'pending').length;
                 const approvedCount = task.approvedCount || 0;
                 const pct = task.numWorkers > 0
                               ? Math.min(100, Math.round((approvedCount / task.numWorkers) * 100))
                               : 0;
            %>
            <tr>
              <td>
                <div class="task-name"><%= task.taskName %></div>
                <div class="task-meta">
                  by <%= task.postedBy ? task.postedBy.username : 'Unknown' %>
                  &bull; <%= task.numWorkers %> worker<%= task.numWorkers !== 1 ? 's' : '' %>
                </div>
              </td>
              <td>
                <span class="badge badge-<%= task.status %>">
                  <%= task.status.toUpperCase() %>
                </span>
              </td>
              <td>
                <div class="progress-wrap">
                  <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width:<%= pct %>%"></div>
                  </div>
                  <span class="progress-label"><%= approvedCount %>/<%= task.numWorkers %></span>
                </div>
              </td>
              <td><span class="kes">KES <%= task.payPerTask.toLocaleString() %></span></td>
              <td><span class="kes">KES <%= (task.escrowAmount || 0).toLocaleString() %></span></td>
              <td>
                <% if (pendingCount > 0) { %>
                  <span class="badge badge-pending"><%= pendingCount %> pending</span>
                <% } else { %>
                  <span style="color:var(--muted);font-size:0.78rem;">—</span>
                <% } %>
              </td>
              <td style="color:var(--muted);font-size:0.82rem;"><%= task.timeLimit %></td>
              <td style="color:var(--muted);font-size:0.78rem;">
                <%= new Date(task.createdAt).toLocaleDateString('en-KE', { day:'numeric', month:'short', year:'2-digit' }) %>
              </td>
              <td>
                <a href="/admin/tasks/<%= task._id %>" class="action-link">Review</a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

  </div><!-- /content -->
</body>
</html>