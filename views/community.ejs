<%- include('partials/header.ejs'); -%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community Chat</title>
    <style>
        :root {
            --dark-blue: #0a1f44;
            --bright-green: #00e676;
            --white: #ffffff;
            --yellow: #ffd60a;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: var(--dark-blue); }
        .chat-container { max-width: 800px; margin: 0 auto; height: 100vh; display: flex; flex-direction: column; background: var(--white); }
        .chat-header { background: var(--dark-blue); color: var(--yellow); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--bright-green); }
        .chat-header h2 { margin: 0; font-size: 1.2rem; }
        .back-link { color: var(--bright-green); text-decoration: none; font-weight: bold; font-size: 0.9rem; }
        .back-link:hover { color: var(--white); }
        .chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: #f2f6fc; }
        .chat-message { display: flex; }
        .chat-message.own-message { justify-content: flex-end; }
        .message-bubble { max-width: 75%; padding: 10px 14px; border-radius: 14px; background: var(--white); border: 1px solid #d6dee8; display: flex; flex-direction: column; }
        .chat-message.own-message .message-bubble { background: var(--bright-green); color: var(--dark-blue); border: none; }
        .message-username { font-weight: bold; font-size: 0.78rem; color: var(--dark-blue); margin-bottom: 2px; }
        .message-text { margin: 2px 0; word-break: break-word; white-space: pre-wrap; }
        .message-image { max-width: 200px; max-height: 200px; border-radius: 8px; margin-top: 4px; object-fit: cover; }
        .message-time { font-size: 0.68rem; color: #5a6b85; margin-top: 4px; align-self: flex-end; }
        .chat-message.own-message .message-time { color: #0a1f44cc; }
        .chat-input-area { display: flex; align-items: center; gap: 8px; padding: 12px; background: var(--white); border-top: 2px solid var(--bright-green); }
        .image-upload-label { font-size: 1.4rem; cursor: pointer; color: var(--dark-blue); }
        #text-input { flex: 1; padding: 10px 14px; border: 2px solid var(--dark-blue); border-radius: 20px; outline: none; font-size: 0.95rem; }
        #text-input:focus { border-color: var(--bright-green); }
        .send-btn { background: var(--yellow); color: var(--dark-blue); border: none; padding: 10px 18px; border-radius: 20px; font-weight: bold; cursor: pointer; }
        .send-btn:hover { background: var(--bright-green); }
        #image-preview-name { font-size: 0.75rem; color: var(--dark-blue); padding: 0 12px; margin: 4px 0 0; }
        @media (max-width: 600px) {
            .message-bubble { max-width: 85%; }
            .chat-header h2 { font-size: 1rem; }
            .send-btn { padding: 10px 14px; }
        }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="chat-header">
        <h2>🌐 Community Chat</h2>
        <a href="/home" class="back-link">← Back to Dashboard</a>
    </div>

    <div class="chat-messages" id="chat-messages">
        <% messages.forEach(msg => { %>
            <div class="chat-message <%= msg.user.toString() === user._id.toString() ? 'own-message' : '' %>">
                <div class="message-bubble">
                    <span class="message-username"><%= msg.username %></span>
                    <% if (msg.text) { %><p class="message-text"><%= msg.text %></p><% } %>
                    <% if (msg.image) { %><img src="<%= msg.image %>" class="message-image" alt="shared image"/><% } %>
                    <span class="message-time"><%= new Date(msg.createdAt).toLocaleTimeString() %></span>
                </div>
            </div>
        <% }) %>
    </div>

    <form id="chat-form" class="chat-input-area">
        <label for="image-input" class="image-upload-label" title="Attach image (max 2MB)">📎</label>
        <input type="file" id="image-input" name="image" accept="image/*" hidden/>
        <input type="text" id="text-input" name="text" placeholder="Type a message..." maxlength="500" autocomplete="off"/>
        <button type="submit" class="send-btn">Send</button>
    </form>
    <p id="image-preview-name"></p>
</div>

<script>
    const chatMessages = document.getElementById("chat-messages");
    const chatForm     = document.getElementById("chat-form");
    const textInput    = document.getElementById("text-input");
    const imageInput   = document.getElementById("image-input");
    const previewName  = document.getElementById("image-preview-name");
    const currentUserId = "<%= user._id %>";

    let lastMessageCount = <%= messages.length %>;

    function renderMessage(msg) {
        const isOwn = (msg.user || "").toString() === currentUserId;
        const div = document.createElement("div");
        div.className = "chat-message" + (isOwn ? " own-message" : "");

        const bubble = document.createElement("div");
        bubble.className = "message-bubble";

        const nameEl = document.createElement("span");
        nameEl.className = "message-username";
        nameEl.textContent = msg.username;
        bubble.appendChild(nameEl);

        if (msg.text) {
            const textEl = document.createElement("p");
            textEl.className = "message-text";
            textEl.textContent = msg.text;
            bubble.appendChild(textEl);
        }

        if (msg.image) {
            const imgEl = document.createElement("img");
            imgEl.className = "message-image";
            imgEl.src = msg.image;
            imgEl.alt = "shared image";
            bubble.appendChild(imgEl);
        }

        const timeEl = document.createElement("span");
        timeEl.className = "message-time";
        timeEl.textContent = new Date(msg.createdAt).toLocaleTimeString();
        bubble.appendChild(timeEl);

        div.appendChild(bubble);
        chatMessages.appendChild(div);
    }

    async function pollMessages() {
        try {
            const res  = await fetch('/community/messages');
            const data = await res.json();
            if (data.success && data.messages.length !== lastMessageCount) {
                chatMessages.innerHTML = "";
                data.messages.forEach(renderMessage);
                lastMessageCount = data.messages.length;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        } catch (err) {
            console.error("Failed to poll messages:", err);
        }
    }

    chatForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = textInput.value.trim();
        const file = imageInput.files[0];
        if (!text && !file) return;

        if (file && file.size > 2 * 1024 * 1024) {
            alert("Image must be smaller than 2MB.");
            return;
        }

        const formData = new FormData();
        formData.append("text", text);
        if (file) formData.append("image", file);

        try {
            const res  = await fetch("/community/message", { method: "POST", body: formData });
            const data = await res.json();

            if (data.success) {
                textInput.value = "";
                imageInput.value = "";
                previewName.textContent = "";
                renderMessage(data.message);
                lastMessageCount++;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            } else {
                alert(data.error || "Could not send message.");
            }
        } catch (err) {
            console.error(err);
            alert("Failed to send message.");
        }
    });

    imageInput.addEventListener("change", () => {
        previewName.textContent = imageInput.files[0] ? `📎 ${imageInput.files[0].name}` : "";
    });

    window.addEventListener("DOMContentLoaded", () => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    });

    setInterval(pollMessages, 4000);
</script>

</body>
</html>