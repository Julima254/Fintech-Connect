<%- include('../partials/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Transactions</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:      #0a1628;
            --navy-mid:  #112240;
            --green:     #00e676;
            --yellow:    #ffd600;
            --white:     #ffffff;
            --muted:     #8899bb;
            --border:    #1e3a5f;
            --danger:    #ff5252;
            --radius:    10px;
        }

        body {
            background: var(--navy);
            color: var(--white);
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        .topbar {
            background: var(--navy-mid);
            border-bottom: 2px solid var(--border);
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .topbar-title { font-size: 1.2rem; font-weight: 700; color: var(--green); }
        .topbar-back {
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }
        .topbar-back:hover { color: var(--white); }

        .flash-wrap { padding: 12px 24px 0; }
        .flash { padding: 12px 16px; border-radius: var(--radius); font-size: 0.9rem; margin-bottom: 8px; }
        .flash.success { background: rgba(0,230,118,0.12); border: 1px solid var(--green); color: var(--green); }
        .flash.error   { background: rgba(255,82,82,0.12);  border: 1px solid var(--danger); color: var(--danger); }

        .page { max-width: 960px; margin: 0 auto; padding: 24px 16px; }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
        }
        .card {
            background: var(--navy-mid);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 20px;
        }
        .card-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 8px; }
        .card-value { font-size: 1.6rem; font-weight: 800; line-height: 1; }
        .card-value.green  { color: var(--green); }
        .card-value.yellow { color: var(--yellow); }
        .card-value.white  { color: var(--white); }
        .card-value.muted  { color: var(--muted); }

        .filters-wrap {
            background: var(--navy-mid);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 20px;
            margin-bottom: 20px;
        }
        .filters-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 14px; }
        .filters-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
        .filter-group { display: flex; flex-direction: column; gap: 5px; min-width: 130px; }
        .filter-group label { font-size: 0.75rem; color: var(--muted); }
        .filter-group select,
        .filter-group input[type="date"] {
            background: var(--navy);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--white);
            padding: 8px 10px;
            font-size: 0.85rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .filter-group select:focus,
        .filter-group input[type="date"]:focus { border-color: var(--green); }

        .btn {
            padding: 9px 20px;
            border-radius: 6px;
            border: none;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.2s;
        }
        .btn-green   { background: var(--green); color: var(--navy); }
        .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--muted); }
        .btn-outline:hover { border-color: var(--muted); color: var(--white); }

        .table-wrap {
            background: var(--navy-mid);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }
        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
        }
        .table-header-title { font-size: 0.9rem; font-weight: 600; }
        .table-count { font-size: 0.78rem; color: var(--muted); }

        .tx-table { width: 100%; border-collapse: collapse; }
        .tx-table thead th {
            background: var(--navy);
            padding: 11px 16px;
            text-align: left;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--muted);
            font-weight: 600;
        }
        .tx-table tbody tr { border-bottom: 1px solid var(--border); transition: background 0.15s; }
        .tx-table tbody tr:last-child { border-bottom: none; }
        .tx-table tbody tr:hover { background: rgba(255,255,255,0.03); }
        .tx-table td { padding: 13px 16px; font-size: 0.88rem; vertical-align: middle; }

        .tx-link { color: var(--white); text-decoration: none; font-weight: 500; }
        .tx-link:hover { color: var(--green); }
        .tx-code { font-family: monospace; font-size: 0.8rem; color: var(--muted); }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-deposit    { background: rgba(0,230,118,0.15);  color: var(--green); }
        .badge-withdrawal { background: rgba(255,214,0,0.15);  color: var(--yellow); }
        .badge-referral   { background: rgba(33,150,243,0.15); color: #64b5f6; }
        .badge-task       { background: rgba(156,39,176,0.15); color: #ce93d8; }
        .badge-shares     { background: rgba(255,152,0,0.15);  color: #ffb74d; }

        .status-dot {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.82rem;
            font-weight: 600;
        }
        .status-dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .status-completed::before { background: var(--green); }
        .status-pending::before   { background: var(--yellow); box-shadow: 0 0 6px var(--yellow); }
        .status-failed::before    { background: var(--danger); }
        .status-completed { color: var(--green); }
        .status-pending   { color: var(--yellow); }
        .status-failed    { color: var(--danger); }

        .amount-positive { color: var(--green);  font-weight: 700; }
        .amount-negative { color: var(--yellow); font-weight: 700; }

        .tx-cards { display: none; }
        .tx-card { padding: 16px 20px; border-bottom: 1px solid var(--border); }
        .tx-card:last-child { border-bottom: none; }
        .tx-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .tx-card-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 0.78rem; color: var(--muted); }
        .tx-card-amount { font-size: 1.1rem; font-weight: 800; }

        .empty { padding: 56px 24px; text-align: center; color: var(--muted); }
        .empty-icon { font-size: 2.8rem; margin-bottom: 12px; }
        .empty h3 { font-size: 1rem; color: var(--white); margin-bottom: 6px; }

        .pagination { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 24px; flex-wrap: wrap; }
        .page-btn {
            padding: 7px 14px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--navy-mid);
            color: var(--muted);
            font-size: 0.82rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }
        .page-btn:hover  { border-color: var(--green); color: var(--green); }
        .page-btn.active { background: var(--green); color: var(--navy); border-color: var(--green); font-weight: 700; }
        .page-btn.disabled { opacity: 0.35; pointer-events: none; }

        @media (max-width: 640px) {
            .page { padding: 16px 12px; }
            .tx-table { display: none; }
            .tx-cards { display: block; }
            .summary-grid { grid-template-columns: repeat(2, 1fr); }
            .card-value { font-size: 1.3rem; }
            .filters-form { flex-direction: column; }
            .filter-group { min-width: 100%; }
            .btn { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

<nav class="topbar">
    <a href="/home" class="topbar-back">&#8592; Dashboard</a>
    <span class="topbar-title">Transactions</span>
    <span style="width:80px"></span>
</nav>

<div class="flash-wrap">
    <% if (success && success.length > 0) { %>
        <div class="flash success">&#10003; <%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="flash error">&#9888; <%= error[0] %></div>
    <% } %>
</div>

<div class="page">

    <div class="summary-grid">
        <div class="card">
            <div class="card-label">Total Deposited</div>
            <div class="card-value green">KES <%= summary.totalDeposited.toLocaleString() %></div>
        </div>
        <div class="card">
            <div class="card-label">Total Withdrawn</div>
            <div class="card-value yellow">KES <%= summary.totalWithdrawn.toLocaleString() %></div>
        </div>
        <div class="card">
            <div class="card-label">Total Earned</div>
            <div class="card-value white">KES <%= summary.totalEarned.toLocaleString() %></div>
        </div>
        <div class="card">
            <div class="card-label">Pending</div>
            <div class="card-value muted"><%= summary.pendingCount %> txn<%= summary.pendingCount !== 1 ? 's' : '' %></div>
        </div>
    </div>

    <div class="filters-wrap">
        <div class="filters-title">Filter Transactions</div>
        <form class="filters-form" method="GET" action="/transactions">
            <div class="filter-group">
                <label>Type</label>
                <select name="type">
                    <option value="all"        <%= !query.type || query.type === 'all' ? 'selected' : '' %>>All Types</option>
                    <option value="deposit"    <%= query.type === 'deposit'    ? 'selected' : '' %>>Deposit</option>
                    <option value="withdrawal" <%= query.type === 'withdrawal' ? 'selected' : '' %>>Withdrawal</option>
                    <option value="referral"   <%= query.type === 'referral'   ? 'selected' : '' %>>Referral</option>
                    <option value="task"       <%= query.type === 'task'       ? 'selected' : '' %>>Task</option>
                    <option value="shares"     <%= query.type === 'shares'     ? 'selected' : '' %>>Shares</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status">
                    <option value="all"       <%= !query.status || query.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                    <option value="completed" <%= query.status === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="pending"   <%= query.status === 'pending'   ? 'selected' : '' %>>Pending</option>
                    <option value="failed"    <%= query.status === 'failed'    ? 'selected' : '' %>>Failed</option>
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" name="from" value="<%= query.from || '' %>" />
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" name="to" value="<%= query.to || '' %>" />
            </div>
            <button type="submit" class="btn btn-green">Apply</button>
            <a href="/transactions" class="btn btn-outline">Reset</a>
        </form>
    </div>

    <div class="table-wrap">
        <div class="table-header">
            <span class="table-header-title">Transaction History</span>
            <span class="table-count"><%= totalTransactions %> record<%= totalTransactions !== 1 ? 's' : '' %></span>
        </div>

        <% if (transactions.length === 0) { %>
            <div class="empty">
                <div class="empty-icon">&#128196;</div>
                <h3>No transactions found</h3>
                <p>Try adjusting your filters or make your first deposit.</p>
            </div>
        <% } else { %>

            <table class="tx-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% transactions.forEach(tx => { %>
                        <tr>
                            <td style="color:var(--muted); font-size:0.8rem;">
                                <%= new Date(tx.createdAt).toLocaleDateString('en-KE', { day:'2-digit', month:'short', year:'numeric' }) %>
                                <br>
                                <span style="font-size:0.72rem;">
                                    <%= new Date(tx.createdAt).toLocaleTimeString('en-KE', { hour:'2-digit', minute:'2-digit' }) %>
                                </span>
                            </td>
                            <td class="tx-code"><%= tx.code || tx._id.toString().slice(-8).toUpperCase() %></td>
                            <td><span class="badge badge-<%= tx.type %>"><%= tx.type %></span></td>
                            <td style="color:var(--muted); font-size:0.82rem; text-transform:uppercase;"><%= tx.method %></td>
                            <td class="<%= tx.type === 'withdrawal' ? 'amount-negative' : 'amount-positive' %>">
                                <%= tx.type === 'withdrawal' ? '-' : '+' %>KES <%= tx.amount.toLocaleString() %>
                            </td>
                            <td>
                                <span class="status-dot status-<%= tx.status %>">
                                    <%= tx.status.charAt(0).toUpperCase() + tx.status.slice(1) %>
                                </span>
                            </td>
                            <td>
                                <a href="/transactions/<%= tx._id %>" class="tx-link" style="font-size:0.8rem;">View ›</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="tx-cards">
                <% transactions.forEach(tx => { %>
                    <div class="tx-card">
                        <div class="tx-card-top">
                            <div>
                                <span class="badge badge-<%= tx.type %>"><%= tx.type %></span>
                                &nbsp;
                                <span class="status-dot status-<%= tx.status %>" style="font-size:0.75rem;"><%= tx.status %></span>
                            </div>
                            <div class="tx-card-amount <%= tx.type === 'withdrawal' ? 'amount-negative' : 'amount-positive' %>">
                                <%= tx.type === 'withdrawal' ? '-' : '+' %>KES <%= tx.amount.toLocaleString() %>
                            </div>
                        </div>
                        <div class="tx-card-meta">
                            <span><%= new Date(tx.createdAt).toLocaleDateString('en-KE', { day:'2-digit', month:'short', year:'numeric' }) %></span>
                            <span>&bull;</span>
                            <span style="text-transform:uppercase;"><%= tx.method %></span>
                            <% if (tx.code) { %><span>&bull; <%= tx.code %></span><% } %>
                        </div>
                        <a href="/transactions/<%= tx._id %>" style="display:inline-block; margin-top:10px; font-size:0.8rem; color:var(--green); text-decoration:none;">
                            View details ›
                        </a>
                    </div>
                <% }) %>
            </div>

        <% } %>
    </div>

    <% if (totalPages > 1) { %>
        <div class="pagination">
            <a href="?<%= new URLSearchParams({...query, page: currentPage - 1}).toString() %>"
               class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>">‹ Prev</a>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                    <a href="?<%= new URLSearchParams({...query, page: i}).toString() %>"
                       class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                    <span class="page-btn disabled">…</span>
                <% } %>
            <% } %>
            <a href="?<%= new URLSearchParams({...query, page: currentPage + 1}).toString() %>"
               class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>">Next ›</a>
        </div>
    <% } %>

</div>
</body>
</html>