<%- include('../partials/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaction Detail</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:     #0a1628;
            --navy-mid: #112240;
            --green:    #00e676;
            --yellow:   #ffd600;
            --white:    #ffffff;
            --muted:    #8899bb;
            --border:   #1e3a5f;
            --danger:   #ff5252;
            --radius:   10px;
        }

        body {
            background: var(--navy);
            color: var(--white);
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        .topbar {
            background: var(--navy-mid);
            border-bottom: 2px solid var(--border);
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .topbar-title { font-size: 1.1rem; font-weight: 700; color: var(--green); }
        .topbar-back { color: var(--muted); text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
        .topbar-back:hover { color: var(--white); }

        .page { max-width: 580px; margin: 0 auto; padding: 28px 16px; }

        .amount-hero {
            text-align: center;
            padding: 36px 24px;
            background: var(--navy-mid);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            margin-bottom: 20px;
        }
        .amount-hero .label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 12px; }
        .amount-hero .amount { font-size: 2.8rem; font-weight: 900; line-height: 1; margin-bottom: 16px; }
        .amount-hero .amount.positive { color: var(--green); }
        .amount-hero .amount.negative { color: var(--yellow); }

        .badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-right: 6px;
        }
        .badge-deposit    { background: rgba(0,230,118,0.15);  color: var(--green); }
        .badge-withdrawal { background: rgba(255,214,0,0.15);  color: var(--yellow); }
        .badge-referral   { background: rgba(33,150,243,0.15); color: #64b5f6; }
        .badge-task       { background: rgba(156,39,176,0.15); color: #ce93d8; }
        .badge-shares     { background: rgba(255,152,0,0.15);  color: #ffb74d; }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-pill::before { content: ''; width: 7px; height: 7px; border-radius: 50%; }
        .status-completed { background: rgba(0,230,118,0.1);  color: var(--green); }
        .status-completed::before { background: var(--green); }
        .status-pending   { background: rgba(255,214,0,0.1);  color: var(--yellow); }
        .status-pending::before   { background: var(--yellow); box-shadow: 0 0 6px var(--yellow); }
        .status-failed    { background: rgba(255,82,82,0.1);   color: var(--danger); }
        .status-failed::before    { background: var(--danger); }

        .detail-card {
            background: var(--navy-mid);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            margin-bottom: 16px;
        }
        .detail-card-title {
            padding: 13px 20px;
            background: var(--navy);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            gap: 12px;
        }
        .detail-row:last-child { border-bottom: none; }
        .detail-key { font-size: 0.82rem; color: var(--muted); flex-shrink: 0; }
        .detail-val { font-size: 0.88rem; color: var(--white); font-weight: 500; text-align: right; word-break: break-all; }
        .detail-val.mono { font-family: monospace; font-size: 0.82rem; color: var(--muted); }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            width: 100%;
            transition: all 0.2s;
        }
        .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--muted); }
        .btn-outline:hover { border-color: var(--green); color: var(--green); }

        .alert {
            border-radius: var(--radius);
            padding: 14px 18px;
            margin-bottom: 20px;
            font-size: 0.85rem;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }
        .alert-pending { background: rgba(255,214,0,0.08); border: 1px solid rgba(255,214,0,0.3); color: var(--yellow); }
        .alert-failed  { background: rgba(255,82,82,0.08); border: 1px solid rgba(255,82,82,0.3);  color: var(--danger); }

        @media (max-width: 480px) {
            .page { padding: 16px 12px; }
            .amount-hero .amount { font-size: 2.2rem; }
            .detail-row { flex-direction: column; align-items: flex-start; gap: 4px; }
            .detail-val { text-align: left; }
        }
    </style>
</head>
<body>

<nav class="topbar">
    <a href="/transactions" class="topbar-back">&#8592; Transactions</a>
    <span class="topbar-title">Detail</span>
    <span style="width:80px"></span>
</nav>

<div class="page">

    <div class="amount-hero">
        <div class="label">Transaction Amount</div>
        <div class="amount <%= transaction.type === 'withdrawal' ? 'negative' : 'positive' %>">
            <%= transaction.type === 'withdrawal' ? '-' : '+' %>KES <%= transaction.amount.toLocaleString() %>
        </div>
        <span class="badge badge-<%= transaction.type %>"><%= transaction.type %></span>
        <span class="status-pill status-<%= transaction.status %>"><%= transaction.status %></span>
    </div>

    <div class="detail-card">
        <div class="detail-card-title">Transaction Info</div>
        <div class="detail-row">
            <span class="detail-key">Reference ID</span>
            <span class="detail-val mono"><%= transaction._id %></span>
        </div>
        <% if (transaction.code) { %>
        <div class="detail-row">
            <span class="detail-key">Code</span>
            <span class="detail-val mono"><%= transaction.code %></span>
        </div>
        <% } %>
        <div class="detail-row">
            <span class="detail-key">Type</span>
            <span class="detail-val" style="text-transform:capitalize;"><%= transaction.type %></span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Method</span>
            <span class="detail-val" style="text-transform:uppercase;"><%= transaction.method %></span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Status</span>
            <span class="detail-val" style="text-transform:capitalize;"><%= transaction.status %></span>
        </div>
        <% if (transaction.checkoutRequestID) { %>
        <div class="detail-row">
            <span class="detail-key">Checkout Request ID</span>
            <span class="detail-val mono"><%= transaction.checkoutRequestID %></span>
        </div>
        <% } %>
    </div>

    <div class="detail-card">
        <div class="detail-card-title">Timestamps</div>
        <div class="detail-row">
            <span class="detail-key">Created</span>
            <span class="detail-val">
                <%= new Date(transaction.createdAt).toLocaleDateString('en-KE', { weekday:'short', day:'2-digit', month:'long', year:'numeric' }) %>
                &nbsp;&bull;&nbsp;
                <%= new Date(transaction.createdAt).toLocaleTimeString('en-KE', { hour:'2-digit', minute:'2-digit', second:'2-digit' }) %>
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Last Updated</span>
            <span class="detail-val">
                <%= new Date(transaction.updatedAt).toLocaleDateString('en-KE', { weekday:'short', day:'2-digit', month:'long', year:'numeric' }) %>
                &nbsp;&bull;&nbsp;
                <%= new Date(transaction.updatedAt).toLocaleTimeString('en-KE', { hour:'2-digit', minute:'2-digit', second:'2-digit' }) %>
            </span>
        </div>
    </div>

    <% if (transaction.status === 'pending') { %>
    <div class="alert alert-pending">
        <span>&#9202;</span>
        <span>This transaction is still being processed. It usually completes within a few minutes. Contact support if it stays pending for more than 24 hours.</span>
    </div>
    <% } %>

    <% if (transaction.status === 'failed') { %>
    <div class="alert alert-failed">
        <span>&#9888;</span>
        <span>This transaction failed. No funds were debited or credited. Please try again or contact support with your Reference ID.</span>
    </div>
    <% } %>

    <a href="/transactions" class="btn btn-outline">&#8592; Back to Transactions</a>

</div>
</body>
</html>